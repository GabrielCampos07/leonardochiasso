# Leonardo Chiasso — Angular SPA on Hostinger / LiteSpeed
# Deep links (/alta-costura, /colecao/..., etc.) must fall back to index.html.

<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # Don't rewrite the SPA entry itself.
  RewriteRule ^index\.html$ - [L]

  # Serve real files and directories (assets, JS, CSS, media) as-is.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Client routes → Angular index (relative path works better on LiteSpeed).
  RewriteRule ^ index.html [L]
</IfModule>

# Content-hashed 3D assets (scripts/stockroom-3d-assets.mjs, scripts/stockroom-sketchfab-assets.mjs) never change in place.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.[0-9a-f]{8}\.(glb|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # SPA entry must revalidate; hashed .js / .glb / .webp stay immutable.
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Safety net if rewrite is disabled or skipped.
ErrorDocument 404 /index.html
