# Leo Chiasso API — produção (Hetzner + Neon + Cloudflare R2)
# Copie para o servidor: cp .env.production.example .env && nano .env
# NUNCA commite o .env real (secrets).

# --- Postgres (Neon) ---
# Pooler (API em runtime) — use -pooler no host + pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=30"
# Direct (migrations / prisma migrate) — host sem -pooler
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- API ---
PORT=3000
NODE_ENV=production

# Desligado em produção
ENABLE_DEV_LOGIN=false

# Origens do site (Hostinger) — credentials: true exige lista explícita
CORS_ORIGINS="https://leonardochiasso.com,https://www.leonardochiasso.com"

# Sessão admin/cliente — gere: openssl rand -base64 48
SESSION_SECRET="cole-uma-string-longa-aleatoria-aqui"
SESSION_COOKIE_NAME="lc_session"

# Vazio em prod quando mídia está no CDN (URLs vêm do banco)
PUBLIC_ASSET_BASE=

# --- Admin inline (/admin) ---
ADMIN_EMAIL="admin@leonardochiasso.com"
ADMIN_PASSWORD="senha-forte-somente-no-servidor"

# --- Cloudflare R2 (S3-compatible) ---
# CDN = URL pública (r2.dev ou cdn.leonardochiasso.com) — SEM barra no final
CDN_BASE_URL="https://pub-xxxx.r2.dev"
# Endpoint S3 (NÃO é o CDN): dash.cloudflare.com → R2 → Manage R2 API Tokens
STORAGE_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
STORAGE_BUCKET="leochiasso"
STORAGE_ACCESS_KEY="access-key-do-token-r2"
STORAGE_SECRET_KEY="secret-key-do-token-r2"
STORAGE_REGION=auto

# --- Storefront (checkout desativado no frontend; manter URL do site) ---
STOREFRONT_URL="https://leonardochiasso.com"

# Stripe — deixe vazio enquanto checkout estiver fora do escopo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
