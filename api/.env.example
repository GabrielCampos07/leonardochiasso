# PostgreSQL — host port 5433 (see docker-compose.yml; avoids clash with local :5432)
DATABASE_URL="postgresql://leo:leo@localhost:5433/leo_chiasso?schema=public"

# API
PORT=3000
NODE_ENV=development

# Opt-in passwordless login for local UX only. Ignored when NODE_ENV=production.
# Never enable this on a shared or production host.
ENABLE_DEV_LOGIN=true

# Comma-separated origins allowed by CORS (Angular storefront + future admin)
# Credentials are enabled, so each storefront origin must be listed explicitly.
CORS_ORIGINS="http://localhost:4200"

# Customer auth — HMAC key for hashing session tokens before they are stored.
# Only the HMAC lands in `sessions.token_hash`; the raw token stays in the cookie.
# Rotating this value invalidates every active session. Use a long random string.
SESSION_SECRET="change-me-in-production"
# Optional cookie name override (default: lc_session).
# Cookie is httpOnly, sameSite=lax, path=/, 7-day maxAge, secure when NODE_ENV=production.
SESSION_COOKIE_NAME="lc_session"

# Phase 1 media: prefix for seeded asset paths (SPA serves /assets/...).
# Leave empty to return relative paths like "assets/media/..." that the Angular app resolves.
# Example absolute: PUBLIC_ASSET_BASE="http://localhost:4200"
PUBLIC_ASSET_BASE=

# Future S3-compatible storage + CDN (Phase 2 — placeholders only)
CDN_BASE_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# Stripe Checkout (fill with test keys — leave empty until ready)
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Storefront origin for success/cancel redirects
STOREFRONT_URL="http://localhost:4200"

# Local webhook forward:
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
